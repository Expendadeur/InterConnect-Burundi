# ==========================================
# InterConnect Burundi — Environment Config
# ==========================================
# Copiez ce fichier en .env et remplissez les valeurs

# Application
NODE_ENV=production
APP_NAME=InterConnect Burundi
APP_URL=https://your-domain.com

# Backend
PORT=3000
BACKEND_PORT=3000

# Database PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=interconnect_db
POSTGRES_USER=interconnect_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_VERY_LONG_RANDOM_STRING_64_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Supabase (Auth & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# LiveKit (Audio/Video calls)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_WS_URL=wss://your-livekit-server.com

# Firebase Cloud Messaging (Notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI Services
AI_TRANSLATION_PORT=8001
AI_STT_PORT=8002
AI_TTS_PORT=8003
AI_SERVICE_URL=http://ai-translation:8000

# Google APIs (AI Services)
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key
GOOGLE_SPEECH_API_KEY=your-google-speech-api-key
GOOGLE_TTS_API_KEY=your-google-tts-api-key
DEEPL_API_KEY=your-deepl-api-key

# Whisper (STT local)
WHISPER_MODEL=base

# CORS
CORS_ORIGIN=https://your-domain.com

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
