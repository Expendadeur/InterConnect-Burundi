# ============================================
# Backend .env.example — InterConnect Burundi
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS commiter le .env avec les vrais secrets!
# ============================================

NODE_ENV=production
PORT=3000

# Base de données Supabase (Pooler Frankfurt)
DATABASE_URL=postgresql://postgres.VOTRE_PROJECT_ID:VOTRE_MOT_DE_PASSE@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# JWT
JWT_SECRET=changez-moi-en-secret-aleatoire-long-au-moins-64-chars
JWT_REFRESH_SECRET=changez-moi-aussi-en-autre-secret-aleatoire-long

# Supabase
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_KEY=votre_service_role_key_ici

# LiveKit WebRTC
LIVEKIT_API_KEY=votre_livekit_api_key
LIVEKIT_API_SECRET=votre_livekit_api_secret
LIVEKIT_WS_URL=wss://votre-room.livekit.cloud

# Service de traduction IA (URL de votre service FastAPI déployé)
AI_SERVICE_URL=https://votre-ai-service.onrender.com
